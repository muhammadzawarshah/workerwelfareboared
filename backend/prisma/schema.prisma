  late_fee_rules                                                      late_fee_rules[]
  rent_payments                                                       rent_payments[]
  rent_rates                                                          rent_rates[]
  rent_remittances_rent_remittances_caretaker_user_idTousers          rent_remittances[]       @relation("rent_remittances_caretaker_user_idTousers")
  rent_remittances_rent_remittances_received_by_user_idTousers        rent_remittances[]       @relation("rent_remittances_received_by_user_idTousers")
