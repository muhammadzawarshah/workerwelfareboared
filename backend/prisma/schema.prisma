model utility_bill_fetch_attempts {
  id                    Int                  @id @default(autoincrement())
  utility_connection_id Int
  billing_month         DateTime             @db.Date
  attempted_at          DateTime?            @default(now()) @db.Timestamp(6)
  status                fetch_attempt_status
  api_response_code     String?              @db.VarChar(100)
  error_message         String?              @db.VarChar(500)
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  utility_connections   utility_connections  @relation(fields: [utility_connection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model utility_bills {
  id                    Int                  @id @default(autoincrement())
  utility_connection_id Int?
  flat_assignment_id    Int?
  worker_id             Int?
  flat_id               Int?
  utility_type          utility_type
  billing_month         DateTime             @db.Date
  amount                BigInt               @default(0)
  due_date              DateTime?            @db.Date
  status                bill_status          @default(unpaid)
  created_by            Int?
  created_at            DateTime?            @default(now()) @db.Timestamp(6)
  updated_at            DateTime?            @default(now()) @db.Timestamp(6)
  users                 users?               @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  flat_assignments      flat_assignments?    @relation(fields: [flat_assignment_id], references: [id], onUpdate: NoAction)
  residential_units     residential_units?   @relation(fields: [flat_id], references: [id], onUpdate: NoAction)
  utility_connections   utility_connections? @relation(fields: [utility_connection_id], references: [id], onUpdate: NoAction)
  workers               workers?             @relation(fields: [worker_id], references: [id], onUpdate: NoAction)
  utility_payments      utility_payments[]

  @@unique([utility_connection_id, billing_month])
  @@index([billing_month], map: "idx_utility_bills_billing_month")
}

model utility_connections {
  id                          Int                           @id @default(autoincrement())
  flat_id                     Int
  utility_type                utility_type
  provider_name               String?                       @db.VarChar(255)
  consumer_number             String                        @db.VarChar(255)
  is_active                   Boolean                       @default(true)
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  utility_bill_fetch_attempts utility_bill_fetch_attempts[]
  utility_bills               utility_bills[]
  residential_units           residential_units             @relation(fields: [flat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([utility_type, consumer_number])
}

model utility_payments {
  id                                                 Int           @id @default(autoincrement())
  utility_bill_id                                    Int
  amount                                             BigInt
  payment_date                                       DateTime      @db.Date
  collected_by_user_id                               Int?
  receipt_no                                         String?       @db.VarChar(100)
  created_by                                         Int?
  created_at                                         DateTime?     @default(now()) @db.Timestamp(6)
  updated_at                                         DateTime?     @default(now()) @db.Timestamp(6)
  users_utility_payments_collected_by_user_idTousers users?        @relation("utility_payments_collected_by_user_idTousers", fields: [collected_by_user_id], references: [id], onUpdate: NoAction)
  users_utility_payments_created_byTousers           users?        @relation("utility_payments_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  utility_bills                                      utility_bills @relation(fields: [utility_bill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model worker_applications {
  id                                                                                Int                  @id @default(autoincrement())
  application_no                                                                    String               @unique @db.VarChar(100)
  application_type                                                                  application_type
  status                                                                            application_status   @default(draft)
  worker_id                                                                         Int
  industry_id                                                                       Int?
  submitted_by_user_id                                                              Int?
  current_flat_assignment_id                                                        Int?
  requested_colony_id                                                               Int?
  requested_unit_type                                                               String?              @db.VarChar(100)
  submitted_at                                                                      DateTime?            @db.Timestamp(6)
  verified_by                                                                       Int?
  verified_at                                                                       DateTime?            @db.Timestamp(6)
    verification_status                                                               verification_status? @default(pending)
    verification_remarks                                                              String?              @db.VarChar(500)
    recommended_rent_amount                                                           BigInt?
    committee_meeting_id                                                              Int?
  committee_decision                                                                committee_decision?
  committee_decision_date                                                           DateTime?            @db.Date
  committee_remarks                                                                 String?              @db.VarChar(500)
  approved_by                                                                       Int?
  approved_at                                                                       DateTime?            @db.Timestamp(6)
  rejected_by                                                                       Int?
  rejected_at                                                                       DateTime?            @db.Timestamp(6)
  rejected_reason                                                                   String?              @db.VarChar(500)
  priority_score                                                                    Int?                 @default(0)
  remarks                                                                           String?              @db.VarChar(500)
  created_at                                                                        DateTime?            @default(now()) @db.Timestamp(6)
  updated_at                                                                        DateTime?            @default(now()) @db.Timestamp(6)
  documents                                                                         documents[]
  flat_assignments_flat_assignments_application_idToworker_applications             flat_assignments[]   @relation("flat_assignments_application_idToworker_applications")
  notifications                                                                     notifications[]
  flat_assignments_worker_applications_current_flat_assignment_idToflat_assignments flat_assignments?    @relation("worker_applications_current_flat_assignment_idToflat_assignments", fields: [current_flat_assignment_id], references: [id], onUpdate: NoAction, map: "fk_worker_applications_current_assignment")
  users_worker_applications_approved_byTousers                                      users?               @relation("worker_applications_approved_byTousers", fields: [approved_by], references: [id], onUpdate: NoAction)
  industries                                                                        industries?          @relation(fields: [industry_id], references: [id], onUpdate: NoAction)
  users_worker_applications_rejected_byTousers                                      users?               @relation("worker_applications_rejected_byTousers", fields: [rejected_by], references: [id], onUpdate: NoAction)
  colonies                                                                          colonies?            @relation(fields: [requested_colony_id], references: [id], onUpdate: NoAction)
  users_worker_applications_submitted_by_user_idTousers                             users?               @relation("worker_applications_submitted_by_user_idTousers", fields: [submitted_by_user_id], references: [id], onUpdate: NoAction)
  users_worker_applications_verified_byTousers                                      users?               @relation("worker_applications_verified_byTousers", fields: [verified_by], references: [id], onUpdate: NoAction)
  workers                                                                           workers              @relation(fields: [worker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_worker_applications_status")
  @@index([worker_id], map: "idx_worker_applications_worker_id")
}

model workers {
  id                      Int                   @id @default(autoincrement())
  name                    String                @db.VarChar(255)
  father_name             String                @db.VarChar(255)
  cnic                    String                @unique @db.VarChar(15)
  dob                     DateTime              @db.Date
  address                 String?               @db.VarChar(500)
  essi_no                 String?               @unique @db.VarChar(255)
  eobi_no                 String?               @unique @db.VarChar(255)
  designation             String?               @db.VarChar(255)
  salary_per_month        BigInt?
  total_duration_service  Int?
  total_payment_by        String?               @db.VarChar(50)
  total_number_dependents Int?
  mobile_no_1             String?               @db.VarChar(20)
  mobile_no_2             String?               @db.VarChar(20)
  worker_type             worker_type           @default(industry)
  status                  worker_status         @default(pending)
  created_at              DateTime?             @default(now()) @db.Timestamp(6)
  updated_at              DateTime?             @default(now()) @db.Timestamp(6)
  complaints              complaints[]
  eviction_cases          eviction_cases[]
  flat_assignments        flat_assignments?
  rent_invoices           rent_invoices[]
  utility_bills           utility_bills[]
  worker_applications     worker_applications[]
}

